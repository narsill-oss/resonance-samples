# Optional: the network address (defaults to https://net.narsill.io).
# VITE_API_BASE=https://net.narsill.io

# Optional: with the session server running (npm run server), every user the apps act for
# ("Signed in as" in the developer panel) gets their own logical node key from it.
# VITE_SESSION_URL=http://127.0.0.1:8787/session
